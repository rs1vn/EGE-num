from turtle import *

# 1. Настройка скорости и масштаба
speed(0)        # Максимальная скорость отрисовки
tracer(0)       # Мгновенный вывод (убирает анимацию движения)
m = 30          # Масштаб (один шаг равен 30 пикселям)

# 2. Алгоритм из условия задачи (ПРИМЕР)
# ВАЖНО: В начале Черепаха смотрит вправо (на восток), а в ЕГЭ часто — вверх.
# Если в задаче сказано "голова направлена вдоль положительного направления оси ординат",
# раскомментируйте следующую строку:
# left(90)

for _ in range(4):
    forward(10 * m)  # Движение вперед умножаем на масштаб
    right(90)        # Повороты НЕ умножаем на масштаб

# 3. Отрисовка сетки целочисленных точек
up()                 # Поднимаем хвост, чтобы не рисовать линии
for x in range(-20, 20):
    for y in range(-20, 20):
        goto(x * m, y * m)
        dot(4, "red") # Рисуем точку (размер, цвет)

update()             # Обновляем экран, чтобы увидеть все точки сразу
done()               # Оставляем окно открытым
