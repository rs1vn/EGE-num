# Создаем пустой список для сбора всех подходящих чисел N
results = []

# 1. Перебираем исходные числа N в цикле
for n in range(1, 10000):
    
    # 2. Переводим N в двоичную строку сразу без префикса '0b'
    # Спецификатор :b внутри f-строки форматирует число в чистый двоичный вид
    s = f'{n:b}' 
    
    # 3. Модифицируем строку по правилу задачи (пример с четностью самого N)
    if n % 2 == 0:
        s = '10' + s      # Если N четное, дописываем '10' в начало строки
    else:
        s = '1' + s + '01' # Если N нечетное, добавляем '1' в начало и '01' в конец
        
    # 4. Переводим получившуюся двоичную строку в десятичное число R
    r = int(s, 2)
    
    # 5. Проверяем условие для результата R из текста задачи
    if r < 500:
        results.append(n) # Если R подходит, сохраняем исходное N в список

# 6. Находим и выводим МАКСИМАЛЬНОЕ N из всех, что нам подошли
print(max(results)) 
