# Выводим заголовок таблицы для удобства сопоставления
print("x y z w | F")

# Перебираем все возможные комбинации 0 и 1
for x in [0, 1]:
    for y in [0, 1]:
        for z in [0, 1]:
            for w in [0, 1]:
                
                # СЮДА ЗАПИСЫВАЕМ ФОРМУЛУ ИЗ ЗАДАНИЯ
                # Пример формулы: (x → y) ∧ (y → z) ∧ (¬w ≡ x)
                F = ((x <= y) and (y <= z) and ((not w) == x))
                
                # СМОТРИМ НА ТАБЛИЦУ В КИМ: если в столбце функции стоит 1/0, пишем: if F == 1/0:
                # Например в столбце 1:
                if F == 1:
                    print(f"{x} {y} {z} {w} | {int(F)}")
